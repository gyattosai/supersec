# MongoDB Atlas Flex connection string
DATABASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supersec?retryWrites=true&w=majority

# Payload CMS auth secret (32+ characters)
PAYLOAD_SECRET=supersec-local-development-secret-key-32chars-min

# Canonical site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
